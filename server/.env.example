# Postgres
DB_URL=jdbc:postgresql://localhost:5432/rootly
DB_USERNAME=
DB_PASSWORD=

# JWT — gere um valor aleatorio com pelo menos 32 bytes, nunca reutilize este exemplo
JWT_SECRET=

# E-mail (convite de novo usuario e recuperacao de senha via JavaMail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@rootly.local

# Processamento assincrono de e-mails e limpeza de dados expirados
SCHEDULING_ENABLED=true
MAIL_OUTBOX_POLL_INTERVAL_MS=5000
MAINTENANCE_INTERVAL_MS=60000

# URL do frontend, usada para montar os links enviados por e-mail
FRONTEND_URL=http://localhost:5173
