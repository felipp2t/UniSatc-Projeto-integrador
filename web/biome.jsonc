{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react"
  ],
  "javascript": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 80,
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "off",
        "noNestedTernary": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "performance": {
        "noNamespaceImport": "off"
      },
      "correctness": {
        "useImageSize": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/ui/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/pages/**/$*.tsx",
        "src/pages/**/$*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/http/schemas/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/lib/zod"
                    ],
                    "message": "Schemas devem importar 'zod' direto (zod-compiler nao compila via alias)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        ".claude/skills/**",
        ".agents/skills/**"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    }
  ]
}
